ull,"stale":false,"sources":[{"sourceId":"","sourceType":"club_website","url":"https://wishr.weebly.com/application.html","title":"Application - WISHR | Women in Science @ Harvard-Radcliffe","observedAt":"2026-09-30T22:08:15.041Z","isFixture":false,"quote":null}]},"alternatives":[],"conflict":false},"club.long_description":{"kind":"single","current":{"value":"Women in Science at Harvard-Radcliffe, WISHR, founded in 1989, is a multi-faceted organization devoted to fostering a sense of community and solidarity among undergraduate women engaged in science at Harvard College. WISHR is the largest organization on campus that seeks to address the political, social and academic concerns of undergraduate women in the sciences. Towards this goal, WISHR sponsors academic, career, and public service programs, creates mentoring networks with graduate and professional level women, and serves as a multi-disciplinary resource for those pursuing the sciences. WISHR not only provides a support network and resource base, but also fosters discussion on women's issues and provides inspiration and encouragement for those pursuing science-related careers.","claimId":"01a0f180-f1fb-7d8a-9668-28191bbf5a67","badge":"verified","confidence":0,"assertionKind":"stated","bestTier":0,"observedAt":"2026-09-30T10:29:30.216Z","asOf":null,"stale":false,"sources":[{"sourceId":"","sourceType":"club_website","url":"https://wishr.weebly.com/about.html","title":"About - WISHR | Women in Science @ Harvard-Radcliffe","observedAt":"2026-09-30T10:29:30.216Z","isFixture":false,"quote":null},{"sourceId":"","sourceType":"club_website","url":"https://wishr.weebly.com","title":"WISHR | Women in Science @ Harvard-Radcliffe - Home","observedAt":"2026-09-30T10:29:23.314Z","isFixture":false,"quote":null}]},"alternatives":[],"conflict":false},"club.short_description":{"kind":"single","current":{"value":"Women in Science at Harvard-Radcliff","claimId":"01a0f17d-c45b-7fba-a00b-7a7a48b97dee","badge":"verified","confidence