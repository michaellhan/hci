ependent.com/february-rundown","title":"February Rundown | Harvard Independent","observedAt":"2026-09-30T14:06:19.501Z","isFixture":false,"quote":null}]},{"value":{"url":"https://harvardindependent.com/march-rundown/","title":"March Rundown","publisher":"The Harvard Independent","publishedOn":"2022-03-15"},"claimId":"01a0f2a3-2c41-7a0c-adea-bf7721c916ea","badge":"reported","confidence":0,"assertionKind":"stated","bestTier":0,"observedAt":"2026-09-30T14:06:14.917Z","asOf":null,"stale":false,"sources":[{"sourceId":"","sourceType":"harvard_related_other","url":"https://harvardindependent.com/march-rundown","title":"March Rundown | Harvard Independent","observedAt":"2026-09-30T14:06:14.917Z","isFixture":false,"quote":null}]},{"value":{"url":"https://harvardindependent.com/the-discourse-of-art/","title":"The Discourse of Art","publisher":"The Harvard Independent","publishedOn":"2024-03-07"},"claimId":"01a0f2a3-1b6f-71d1-bb67-db5814907da3","badge":"reported","confidence":0,"assertionKind":"stated","bestTier":0,"observedAt":"2026-09-30T14:06:10.607Z","asOf":null,"stale":false,"sources":[{"sourceId":"","sourceType":"harvard_related_other","url":"https://harvardindependent.com/the-discourse-of-art","title":"The Discourse of Art | Harvard Independent","observedAt":"2026-09-30T14:06:10.607Z","isFixture":false,"quote":null}]}]},"club.long_description":{"kind":"single","current":{"value":"The Harvard Advocate, founded in 1866, is the oldest continuously published collegiate literary magazine in the country. Over its long history, it can count T.S. Eliot, Conrad Aiken, and Norman Mailer among its members and e.e. cummings, Jack Kerouac, and Tom Wolfe as contributors to its pages. A quarterly magazine, The Advocate's mission is to publish the best art, fiction, poetry, and prose that the Harvard undergraduate community offers.When the Advocate was founded, it adopted the motto Dulce est Periculum (Danger is Sweet) which had been used by an earlier Harvard newspaper, the Collegian. The magazine originally avoided controversial topics, lest it be shut down by university authorities; by the time the editors were making the then-radical demand for coeducation at Harvard, the magazine had attracted the support of James Russell Lowell and Oliver Wendell Holmes, and its life was less precarious.The founding in 1873 of The Harvard Crimson newspaper (originally the Magenta), and in 1876, of the Harvard Lampoon humor magazine, led the Advocate by the 1880s to devote itself to essays, fiction, and poetry.Over the years, the undergraduate editors of and contributors to the Advocate have gone on to later fame, literary and otherwise. Theodore Roosevelt edited the magazine in 1880. Edwin Arlington Robinson, Wallace Stevens, E. E. Cummings, and T. S. Eliot all published their undergraduate poetry in the Advocate. Before World War II, undergraduates who worked on the Advocate included Malcolm Cowley, James Agee, Robert Fitzgerald, Leonard Bernstein, James Laughlin (who got into trouble with local police for publishing a racy story by Henry Miller) and Norman Mailer.The Harvard Advocate can be reached at 21 South Street, Cambridge, and at president@theharvardadvocate.com","claimId":"01a0fe5f-6229-7558-b72d-82f100bc75bd","badge":"verified","confidence":0,"assertionKind":"stated","bestTier":0,"observedAt":"2026-10-02T20:47:34.226Z","asOf":null,"stale":false,"sources":[{"sourceId":"","sourceType":"club_website","url":"https://theharvardadvocate.com/about","title":"About Us - The Harvard Advocate","observedAt":"2026-10-02T20:47:34.226Z","isFixture":false,"quote":null}]},"alternatives":[],"conflict":false},"club.affiliation_scope":{"kind":"single","current":{"value":"harvard_college","claimId":"01a0f490-3b9f-7e55-883a-f3bea8ab5a7a","badge":"verified","confidence":0,"assertionKind":"stated","bestTier":0,"observedAt":"2026-09-30T23:04:40.834Z","asOf":null,"stale":false,"sources":[{"sourceId":"","sourceType":"harvard_official","url":"https://soco.college.harvard.edu