{"id":"01a0f17d-908d-739c-9c0a-ea68d295db4e","slug":"mission-hill-after-school-program","name":"PBHA Mission Hill Afterschool Program","acronym":null,"shortDescription":"After school program where volunteers help Mission Main and Alice Taylor housing children in grades 1-8 with homework, reading, and workshops.","orgType":"public_service_program","recognitionStatus":"recognized","activityStatus":"likely_active","joinModes":["application"],"freshmenEligible":null,"joining":{"comp":null,"dues":null,"roles":[],"access":"process","noCuts":false,"general":["application"],"conflicts":[],"firstYears":null,"noExperience":null},"categories":[{"slug":"public-service","name":"Public Service"},{"slug":"mentoring-education","name":"Mentoring & Education"}],"memberCount":null,"instagramFollowers":null,"hoursPerWeek":null,"currentCycle":null,"isFixture":false,"completeness":0.7,"sourceCount":3,"lastObservedAt":"2026-09-30T23:04:40.834Z","lastVerifiedAt":"2026-09-30T23:04:40.834Z","eligibleClasses":null,"affiliationScope":"harvard_college","activityConfidence":0.55,"activityReasons":["listed on a current official directory"],"quickLinks":{"website":null,"instagram":null},"logo":null,"pressCount":0,"longDescription":"MHASP is an after school program for children in grades 1-8 who live in Mission Main or Alice Taylor housing developments. The program takes place at the Mission Main Community Center located at 43 Smith Street. Volunteers take the PBHA van or M2 bus from Harvard to Mission Hill at 3:30pm. Non-Harvard volunteers will meet everyone at the community center. The after school students are picked up from their homes or the Tobin elementary school and walked over to program. MHASP takes place in the upstairs classrooms at the Mission Main Community Center.Program begins with students completing their homework, reading a book, or doing math or spelling enrichment activities. Halfway through program, everyone comes together for a question of the day and introduction to the day's activity. The remainder of program is filled with some sort of workshop from creating short stories, making slime, playing trivia, decorating cookies, and more! At 5:45 we clean up the space and either drop the students off at their home or wait for their parents to pick them up from the community center. Volunteers then return to campus, arriving around 6:30pm.","joiningBasis":{"access":{"rule":"stated_process","claimIds":["01a0f227-05ac-7831-ac32-fba7c3fcc067"],"sources":[{"url":"https://pbha.org/programs/missionhill-afterschool","title":"Mission Hill After School Program — PBHA","sourceType":"harvard_official","observedAt":"2026-09-30T10:28:49.667Z","isFixture":false}]}},"aliases":[],"links":[{"kind":"harvard_directory","url":"https://pbha.org/programs/missionhill-afterschool","handle":null,"label":"PBHA program page","status":"verified","confidence":0,"signals":["listed by an official Harvard source"],"discoveredVia":["harvard_official"],"lastObservedAt":"2026-09-30T08:45:33.103Z"}],"cycles":[],"membership":[],"selectivity":null,"sources":[{"id":"01a0f490-0061-7f57-b69f-0f5525065410","url":"https://soco.college.harvard.edu/club_signup","title":"Student organization directory","sourceType":"harvard_official","trustTier":1,"publisher":"Harvard College Student Organization Center (SOCO)","isFixture":false,"claimCount":6,"lastObservedAt":"2026-09-30T23:04:40.834Z"},{"id":"01a0f1dc-06f1-7875-a1a0-9564b3e099d8","url":"https://pbha.org/programs/missionhill-afterschool","title":"Mission Hill After School Program — PBHA","sourceType":"harvard_official","trustTier":1,"publisher":null,"isFixture":false,"claimCount":12,"lastObservedAt":"2026-09-30T10:28:49.667Z"},{"id":"01a0f17d-8791-7bd8-ba91-7759512e0d1e","url":"https://www.pbha.org/programs?offset=1705368180217","title":"PBHA Programs (page) (page)","sourceType":"harvard_official","trustTier":1,"publisher":"Phillips Brooks House Association","isFixture":false,"claimCount":6,"lastObservedAt":"2026-09-30T08:45:33.103Z"}]