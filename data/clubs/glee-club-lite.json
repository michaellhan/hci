 the rich choral repertoire of the Glee Club, becoming a chamber choir for occasions of a more serious nature. Virtually all of our non-classical repertoire is arranged for voices by current or past members of Lite.","claimId":"01a0f23e-2e09-7f93-ae3e-7f7c4cb2bd8e","badge":"reported","confidence":0,"assertionKind":"stated","bestTier":0,"observedAt":"2026-09-30T12:15:07.922Z","asOf":null,"stale":false,"sources":[{"sourceId":"","sourceType":"public_web","url":"https://lite.harvardgleeclub.org/lite.harvardgleeclub.org/about","title":"About – Glee Club Lite","observedAt":"2026-09-30T12:15:07.922Z","isFixture":false,"quote":null},{"sourceId":"","sourceType":"public_web","url":"https://lite.harvardgleeclub.org/about","title":"About – Glee Club Lite","observedAt":"2026-09-30T12:14:58.143Z","isFixture":false,"quote":null}]},"alternatives":[],"conflict":false},"club.freshmen_eligible":{"kind":"single","current":{"value":true,"claimId":"01a0fb48-8c64-70c2-a3f8-1490909b650c","badge":"reported","confidence":0,"assertionKind":"stated","bestTier":0,"observedAt":"2026-09-30T12:14:58.143Z","asOf":null,"stale":false,"sources":[{"sourceId":"","sourceType":"public_web","url":"https://lite.harvardgleeclub.org/about","title":"About – Glee Club Lite","observedAt":"2026-09-30T12:14:58.143Z","isFixture":false,"quote":null}]},"alternatives":[],"conflict":false},"club.short_description":{"kind":"single","current":{"value":"the a cappella subset of the Harvard Glee Club, founded in 1985.","claimId":"01a0f17e-a31f-70b5-bc57-4f55ed51ebd7","badge":"reported","confidence":0,"assertionKind":"stated","bestTier":0,"observedAt":"2026-10-01T14:44:14.838Z","asOf":null,"stale":false,"sources":[{"sourceId":"","sourceType":"public_web","url":"https://en.wikipedia.org/wiki/List_of_Harvard_College_undergraduate_organizations","title":"Wikipedia: List of Harvard College undergraduate organizations","observedAt":"2026-10-01T14:44:14.838Z","isFixture":false,"quote":null}]},"alternatives":[],"conflict":false},"