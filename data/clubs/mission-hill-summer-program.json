{"id":"01a0f17d-9094-7406-8471-def3bbfaa4bc","slug":"mission-hill-summer-program","name":"PBHA's Mission Hill Summer Program","acronym":null,"shortDescription":"Seven-week academic summer camp for Mission Hill youth, run by college student directors and counselors with field trips and workshops.","orgType":"public_service_program","recognitionStatus":"unknown","activityStatus":"likely_active","joinModes":[],"freshmenEligible":null,"joining":{"comp":null,"dues":null,"roles":[],"access":null,"noCuts":false,"general":[],"conflicts":[],"firstYears":null,"noExperience":null},"categories":[{"slug":"public-service","name":"Public Service"},{"slug":"mentoring-education","name":"Mentoring & Education"},{"slug":"advocacy-justice","name":"Advocacy & Justice"}],"memberCount":null,"instagramFollowers":null,"hoursPerWeek":null,"currentCycle":null,"isFixture":false,"completeness":0.5,"sourceCount":3,"lastObservedAt":"2026-09-30T23:04:40.834Z","lastVerifiedAt":"2026-09-30T23:04:40.834Z","eligibleClasses":null,"affiliationScope":"harvard_college","activityConfidence":0.55,"activityReasons":["listed on a current official directory"],"quickLinks":{"website":null,"instagram":null},"logo":null,"pressCount":0,"longDescription":"PBHA's Mission Hill Summer Program (MHSP) provides an affordable, engaging seven-week academic summer program in Boston's Mission Hill neighborhood. Like all of our Summer Urban Program camps, Mission Hill Summer Program engages campers in mornings of academic enrichment, afternoons of educational field trips, and artistic, cultural, and service-learning workshops throughout the week, along with two overnight camping trips and a day-long final trip. In addition to a focus on academic and personal growth, Mission Hill Summer Program works to build community both within Mission Hill and between neighborhoods, collaborating with PBHA's Keylatch Summer Program for a violence prevention program between young people in Mission Hill and the South End's Villa Victoria. Founded in 1989 at the request of Mission Hill parents, Mission Hill Summer Program has become an institution in the community, developing deep partnerships with parents and community-based organizations. The strength of PBHA volunteers’ year-round involvement in Mission Hill allows for long-term connections with children and consistent resources for the parents of Mission Hill. Mission Hill Summer Program works closely with PBHA's Mission Hill Afterschool and Mission Mentor to provide continuous, year-round academic, social, and personal support to young people in Mission Hill.","joiningBasis":{},"aliases":[],"links":[{"kind":"harvard_directory","url":"https://pbha.org/programs/mission-hill-summer-program","handle":null,"label":"PBHA program page","status":"verified","confidence":0,"signals":["listed by an official Harvard source"],"discoveredVia":["harvard_official"],"lastObservedAt":"2026-09-30T08:45:33.103Z"}],"cycles":[],"membership":[],"selectivity":null,"sources":[{"id":"01a0f490-0061-7f57-b69f-0f5525065410","url":"https://soco.college.harvard.edu/club_signup","title":"Student organization directory","sourceType":"harvard_official","trustTier":1,"publisher":"Harvard College Student Organization Center (SOCO)","isFixture":false,"claimCount":5,"lastObservedAt":"2026-09-30T23:04:40.834Z"},{"id":"01a0f1dc-0891-7d04-8a4d-741f8419d587","url":"https://pbha.org/programs/mission-hill-summer-program","title":"Mission Hill Summer Program — PBHA","sourceType":"harvard_official","trustTier":1,"publisher":null,"isFixture":false,"claimCount":19,"lastObservedAt":"2026-09-30T10:28:51.856Z"},{"id":"01a0f17d-8791-7bd8-ba91-7759512e0d1e","url":"https://www.pbha.org/programs?offset=1705368180217","title":"PBHA Programs (page) (page)","sourceType":"harvard_official","trustTier":1,"publisher":"Phillips Brooks House Association","isFixture":false,"claimCount":4,"lastObservedAt":"2026-09-30T08:45:33.103Z"}],"fields":{"club.tag":{"kind":"multi","values":[{"value":"pbha","claimId":"01a0f