{"id":"01a0f17d-7dfd-7208-af46-963d39fe69f8","slug":"brye-summer","name":"BRYE Summer","acronym":null,"shortDescription":"Summer camp run by college students offering ESL enrichment, field trips, and cultural workshops for refugee and immigrant children in Dorchester.","orgType":"public_service_program","recognitionStatus":"unknown","activityStatus":"likely_active","joinModes":[],"freshmenEligible":null,"joining":{"comp":null,"dues":null,"roles":[],"access":null,"noCuts":false,"general":[],"conflicts":[],"firstYears":null,"noExperience":null},"categories":[{"slug":"public-service","name":"Public Service"},{"slug":"cultural-identity","name":"Cultural & Identity"},{"slug":"mentoring-education","name":"Mentoring & Education"}],"memberCount":null,"instagramFollowers":null,"hoursPerWeek":null,"currentCycle":null,"isFixture":false,"completeness":0.5,"sourceCount":3,"lastObservedAt":"2026-09-30T23:04:40.834Z","lastVerifiedAt":"2026-09-30T23:04:40.834Z","eligibleClasses":null,"affiliationScope":"harvard_college","activityConfidence":0.55,"activityReasons":["listed on a current official directory"],"quickLinks":{"website":null,"instagram":null},"logo":null,"pressCount":0,"longDescription":"BRYE began in 1987 as a resource for Boston’s Vietnamese community. Today, BRYE serves all of Dorchester’s refugees and immigrants, especially the Vietnamese, Dominican, Haitian, and Cape Verdean populations. BRYE is the only non-Boston Public School program that is recognized as a substitute for summer school, helping many of its students get promoted to the next grade level. BRYE campers are referred to us through Boston Public School teachers and administrators, social workers and partner community organizations for out-of-school ESL education. Beyond learning English, our youth also face the challenges of integrating themselves into American culture while maintaining their own cultural roots. In addition to ESL enrichment, BRYE emphasizes peaceful conflict resolution and cultural diversity appreciation to mitigate the prevalence of neighborhood violence and racial tensions between the diverse ethnic groups in Boston. Like all of our Summer Urban Program camps, BRYE engages campers in mornings of academic enrichment, afternoons of educational field trips, and artistic, cultural, and service-learning workshops throughout the week, along with two overnight camping trips and a day-long final trip.","joiningBasis":{},"aliases":[],"links":[{"kind":"harvard_directory","url":"https://pbha.org/programs/boston-refugee-youth-enrichment","handle":null,"label":"PBHA program page","status":"verified","confidence":0,"signals":["listed by an official Harvard source"],"discoveredVia":["harvard_official"],"lastObservedAt":"2026-09-30T08:45:28.288Z"}],"cycles":[],"membership":[],"selectivity":null,"sources":[{"id":"01a0f17e-d6af-7fc2-877a-564346bd8cb6","url":"https://pbha.org/programs/boston-refugee-youth-enrichment","title":"BRYE Summer — PBHA","sourceType":"harvard_official","trustTier":1,"publisher":null,"isFixture":false,"claimCount":21,"lastObservedAt":"2026-09-30T10:24:58.392Z"},{"id":"01a0f17d-756a-7702-8a1e-77d393e8b74c","url":"https://www.pbha.org/programs","title":"PBHA Programs","sourceType":"harvard_official","trustTier":1,"publisher":"Phillips Brooks House Association","isFixture":false,"claimCount":4,"lastObservedAt":"2026-09-30T08:45:28.288Z"}],"fields":{"club.tag":{"kind":"multi","values":[{"value":"pbha","claimId":"01a0f490-3712-7dc6-985b-4cf550f3b476","badge":"verified","confidence":0,"assertionKind":"stated","bestTier":0,"observedAt":"2026-09-30T23:04:40.834Z","asOf":null,"stale":false,"sources":[{"sourceId":"","sourceType":"harvard_official","url":"https://soco.college.harvard.edu/club_signup","title":"Student organization directory","observedAt":"2026-09-30T23:04:40.834Z","isFixture":false,"quote":null}]}]},"club.link":{"kind":"multi","values":[{"value":{"url":"https://pbha.org/programs/boston-refugee-youth-enrichment","kind":"harvard_directory