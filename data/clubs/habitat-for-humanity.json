{"id":"01a0f17d-8747-72de-b904-0a02e1ddbf8c","slug":"habitat-for-humanity","name":"PBHA's Harvard Habitat for Humanity","acronym":null,"shortDescription":"Student-run campus chapter working with Habitat for Humanity Greater Boston to build affordable housing and advocate on housing issues.","orgType":"public_service_program","recognitionStatus":"unknown","activityStatus":"likely_active","joinModes":[],"freshmenEligible":null,"joining":{"comp":null,"dues":null,"roles":[],"access":null,"noCuts":false,"general":[],"conflicts":[],"firstYears":null,"noExperience":null},"categories":[{"slug":"public-service","name":"Public Service"},{"slug":"adult-services","name":"Adult Services"}],"memberCount":null,"instagramFollowers":110,"hoursPerWeek":null,"currentCycle":null,"isFixture":false,"completeness":0.5,"sourceCount":5,"lastObservedAt":"2026-10-03T13:30:21.000Z","lastVerifiedAt":"2026-09-30T23:04:40.834Z","eligibleClasses":null,"affiliationScope":"harvard_college","activityConfidence":0.55,"activityReasons":["listed on a current official directory"],"quickLinks":{"website":null,"instagram":"https://www.instagram.com/harvardhabitat"},"logo":null,"pressCount":0,"longDescription":"Harvard Habitat for Humanity is an entirely student-run organization that works with Habitat for Humanity Greater Boston to provide safe, healthy, and affordable housing to community members struggling to make ends meet. We aim to create long-lasting solutions through our group builds and advocacy efforts.The world is experiencing a housing crisis. According to Habitat for Humanity International, nearly 2 billion people worldwide live in inadequate housing, with another 100 million experiencing homelessness. More than just a roof over someone’s head, decent housing provides stability, physical safety, and increased access to good health, education, and a stable job. Habitat for Humanity works to make sure everyone has a decent, safe, affordable place to live. PBHA's Harvard Habitat for Humanity operates as a campus chapter of Habitat for Humanity International, connecting student volunteers with build sites in Greater Boston, as well as running domestic and international trips during Harvard's winter and spring breaks. In addition, we organize advocacy events to promote sustainable solutions to the housing crisis! Through the work of Habitat, thousands of low-income families have found new hope in the form of affordable housing. College campuses like Harvard, community members, and others have joined together to successfully tackle a pressing social need―decent housing for all.","joiningBasis":{},"aliases":[],"links":[{"kind":"harvard_directory","url":"https://pbha.org/programs/harmony-mentoring-ceczy","handle":null,"label":"PBHA program page","status":"verified","confidence":0,"signals":["listed by an official Harvard source"],"discoveredVia":["harvard_official"],"lastObservedAt":"2026-09-30T08:45:30.691Z"},{"kind":"facebook","url":"https://www.facebook.com/harvardhabitatforhumanity","handle":"harvardhabitatforhumanity","label":null,"status":"unverified","confidence":0,"signals":["only seen on lower-trust sources (best tier 8)"],"discoveredVia":["public_web"],"lastObservedAt":"2026-09-30T12:04:19.018Z"},{"kind":"instagram","url":"https://www.instagram.com/harvardhabitat","handle":"harvardhabitat","label":null,"status":"unverified","confidence":0,"signals":["only seen on lower-trust sources (best tier 8)"],"discoveredVia":["public_web"],"lastObservedAt":"2026-09-30T12:04:19.018Z"}],"cycles":[],"membership":[],"selectivity":null,"sources":[{"id":"01a0f490-0061-7f57-b69f-0f5525065410","url":"https://soco.college.harvard.edu/club_signup","title":"Student organization directory","sourceType":"harvard_official","trustTier":1,"publisher":"Harvard College Student Organization Center (SOCO)","isFixture":false,"claimCount":5,"lastObservedAt":"2026-09-30T23:04:40.834Z"},{"id":"01a0f17f-7e9e-7e3c-852b-108e6e6948a0","url":"https://pbha.org/programs/harmony-mentoring-ceczy"