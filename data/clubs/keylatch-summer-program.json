{"id":"01a0f17d-9078-780e-8a06-25be68027783","slug":"keylatch-summer-program","name":"PBHA's Keylatch Summer Program","acronym":null,"shortDescription":"Affordable, college-student-run summer day camp with academics, field trips, and workshops for youth in Boston's South End and Lower Roxbury.","orgType":"public_service_program","recognitionStatus":"unknown","activityStatus":"likely_active","joinModes":[],"freshmenEligible":null,"joining":{"comp":null,"dues":null,"roles":[],"access":null,"noCuts":false,"general":[],"conflicts":[],"firstYears":null,"noExperience":null},"categories":[{"slug":"public-service","name":"Public Service"},{"slug":"mentoring-education","name":"Mentoring & Education"}],"memberCount":null,"instagramFollowers":null,"hoursPerWeek":null,"currentCycle":null,"isFixture":false,"completeness":0.5,"sourceCount":3,"lastObservedAt":"2026-09-30T23:04:40.834Z","lastVerifiedAt":"2026-09-30T23:04:40.834Z","eligibleClasses":null,"affiliationScope":"harvard_college","activityConfidence":0.55,"activityReasons":["listed on a current official directory"],"quickLinks":{"website":null,"instagram":null},"logo":null,"pressCount":0,"longDescription":"PBHA's Keylatch Summer Program (KSP) offers an affordable and engaging summer camp to young people living in Boston’s South End and Lower Roxbury communities. Like all of our Summer Urban Program camps, Keylatch Summer engages campers in mornings of academic enrichment, afternoons of educational field trips, and artistic, cultural, and service-learning workshops throughout the week, along with two overnight camping trips and a day-long final trip. In addition to an academic focus on math and literacy, Keylatch works with campers to explore their community and collaborate with other neighborhoods that have traditionally been perceived as rivals. The Keylatch Committee, of which Keylatch Summer is a major part, has provided consistent, year-round programming for youth in the South End since 1984 at the request of residents, students and parents. Since then, the program has expanded to include children from all areas of the South End and Lower Roxbury community, particularly six public housing developments where access to resources and support is difficult: the Villa Victoria, Cathedral, Castle Square, Lenox, Camden, and Tent City housing developments.","joiningBasis":{},"aliases":[],"links":[{"kind":"harvard_directory","url":"https://pbha.org/programs/keylatch-summer-program","handle":null,"label":"PBHA program page","status":"verified","confidence":0,"signals":["listed by an official Harvard source"],"discoveredVia":["harvard_official"],"lastObservedAt":"2026-09-30T08:45:33.103Z"}],"cycles":[],"membership":[],"selectivity":null,"sources":[{"id":"01a0f490-0061-7f57-b69f-0f5525065410","url":"https://soco.college.harvard.edu/club_signup","title":"Student organization directory","sourceType":"harvard_official","trustTier":1,"publisher":"Harvard College Student Organization Center (SOCO)","isFixture":false,"claimCount":5,"lastObservedAt":"2026-09-30T23:04:40.834Z"},{"id":"01a0f1db-eb53-7b11-812f-a5100e2bb72f","url":"https://pbha.org/programs/keylatch-summer-program","title":"Keylatch Summer Program — PBHA","sourceType":"harvard_official","trustTier":1,"publisher":null,"isFixture":false,"claimCount":15,"lastObservedAt":"2026-09-30T10:28:43.034Z"},{"id":"01a0f17d-8791-7bd8-ba91-7759512e0d1e","url":"https://www.pbha.org/programs?offset=1705368180217","title":"PBHA Programs (page) (page)","sourceType":"harvard_official","trustTier":1,"publisher":"Phillips Brooks House Association","isFixture":false,"claimCount":4,"lastObservedAt":"2026-09-30T08:45:33.103Z"}],"fields":{"club.tag":{"kind":"multi","values":[{"value":"pbha","claimId":"01a0f490-38e6-7869-be48-e75a86bea700","badge":"verified","confidence":0,"assertionKind":"stated","bestTier":0,"observedAt":"2026-09-30T23:04:40.834Z","asOf":null,"stale":false,"sources":[{"sourceId":"","sourceType":"harvard_official","url":"https://soco.college.har