{"id":"01a0f17d-7e0c-7fa0-9204-ad5f5191a876","slug":"cambridge-after-school-program-casp","name":"PBHA: Cambridge Afterschool Program","acronym":"CASP","shortDescription":"After-school homework help and educational workshops for low-income youth ages 8-14 living at Cambridge's Fresh Pond Apartments.","orgType":"public_service_program","recognitionStatus":"recognized","activityStatus":"likely_active","joinModes":["application"],"freshmenEligible":null,"joining":{"comp":null,"dues":null,"roles":[],"access":"process","noCuts":false,"general":["application"],"conflicts":[],"firstYears":null,"noExperience":null},"categories":[{"slug":"public-service","name":"Public Service"},{"slug":"mentoring-education","name":"Mentoring & Education"}],"memberCount":null,"instagramFollowers":null,"hoursPerWeek":null,"currentCycle":null,"isFixture":false,"completeness":0.7,"sourceCount":3,"lastObservedAt":"2026-09-30T23:04:40.834Z","lastVerifiedAt":"2026-09-30T23:04:40.834Z","eligibleClasses":null,"affiliationScope":"harvard_college","activityConfidence":0.55,"activityReasons":["listed on a current official directory"],"quickLinks":{"website":null,"instagram":null},"logo":null,"pressCount":0,"longDescription":"PBHA's Cambridge After School Program (CASP) provides affordable and accessible after school programming for youth at the low-income Fresh Pond Apartments in northwest Cambridge. We serve approximately 30 students ages 8-14, most of whom are first- or second-generation immigrants. CASP offers academic programming in a combination of homework help (the first hour of the program) and educational workshops (the second hour of the program). Workshops range from building model rockets and water balloon slingshots to growing bean plants and making weekly library trips. We also run a variety of field trips including recent trips to a bookstore, the aquarium, and movie nights on the Harvard campus. The program runs Monday-Thursday from 3:30-5:30 pm.Target PopulationThe program serves 3rd-8th graders at the low-income Fresh Pond Apartments in northwest Cambridge. Almost all of our participants are first- or second-immigration immigrants.Program OperationsWe leave the Harvard Square T station at 3 pm to travel to the Alewife station, from where we walk to the Fresh Pond Apartments and arrive by 3:30. We help with homework for (roughly) the first hour, and volunteers lead a game or activity for the second hour. At 5:30, the participants depart, and we take the T back to Harvard, arriving around 6 pm. We also have 1-2 field trips per semester, which usually take an entire Saturday afternoon or evening.","joiningBasis":{"access":{"rule":"stated_process","claimIds":["01a0f224-32c8-7c4b-834e-2444c62e9d18"],"sources":[{"url":"https://pbha.org/programs/casp","title":"Cambridge After-School Program (CASP) — PBHA","sourceType":"harvard_official","observedAt":"2026-09-30T08:47:07.121Z","isFixture":false}]}},"aliases":[{"alias":"PBHA: Cambridge Afterschool Program (CASP)","kind":"alternate"}],"links":[{"kind":"harvard_directory","url":"https://pbha.org/programs/casp","handle":null,"label":"PBHA program page","status":"verified","confidence":0,"signals":["listed by an official Harvard source"],"discoveredVia":["harvard_official"],"lastObservedAt":"2026-09-30T08:45:28.288Z"}],"cycles":[],"membership":[],"selectivity":null,"sources":[{"id":"01a0f490-0061-7f57-b69f-0f5525065410","url":"https://soco.college.harvard.edu/club_signup","title":"Student organization directory","sourceType":"harvard_official","trustTier":1,"publisher":"Harvard College Student Organization Center (SOCO)","isFixture":false,"claimCount":8,"lastObservedAt":"2026-09-30T23:04:40.834Z"},{"id":"01a0f17e-e5be-71dc-bd01-04ecd9b09d62","url":"https://pbha.org/programs/casp","title":"Cambridge After-School Program (CASP) — PBHA","sourceType":"harvard_official","trustTier":1,"publisher":null,"isFixture":false,"claimCount":12,"lastObservedAt":"2026-09-30T10:25:03.126Z"},{"id":"01a0f17d-756a-7702-8a1e-77d3