{"id":"01a0f17d-7e1a-73cd-aa1b-3d0aeab03a95","slug":"chinatown-adventure","name":"PBHA's Chinatown Adventure","acronym":null,"shortDescription":"Seven-week summer camp offering academic enrichment, field trips, and workshops for low-income children ages six to 13 in Boston's Chinatown.","orgType":"public_service_program","recognitionStatus":"unknown","activityStatus":"likely_active","joinModes":[],"freshmenEligible":null,"joining":{"comp":null,"dues":null,"roles":[],"access":null,"noCuts":false,"general":[],"conflicts":[],"firstYears":null,"noExperience":null},"categories":[{"slug":"public-service","name":"Public Service"},{"slug":"mentoring-education","name":"Mentoring & Education"}],"memberCount":null,"instagramFollowers":null,"hoursPerWeek":null,"currentCycle":null,"isFixture":false,"completeness":0.5,"sourceCount":5,"lastObservedAt":"2026-09-30T23:04:40.834Z","lastVerifiedAt":"2026-09-30T23:04:40.834Z","eligibleClasses":null,"affiliationScope":"harvard_college","activityConfidence":0.55,"activityReasons":["listed on a current official directory"],"quickLinks":{"website":null,"instagram":null},"logo":null,"pressCount":1,"longDescription":"PBHA's Chinatown Adventure, or CHAD, seeks to enrich and improve the quality of life for low-income youth in Boston’s Chinatown through a commitment to the academic, social, and personal development of its campers. CHAD fights summer learning loss by reinforcing and strengthening campers’ academic skills, and promotes personal growth among its campers through activities that develop fundamental social skills, healthy identities, cross-cultural awareness, and social consciousness. For more than 25 years, CHAD has offered seven weeks of summer programming to young people ages six to 13. Like all of our Summer Urban Program camps, CHAD engages campers in mornings of academic enrichment, afternoons of educational field trips, and artistic, cultural, and service-learning workshops throughout the week, along with two overnight camping trips and a day-long final trip. CHAD partners with PBHA's term-time Chinatown programs, including Chinatown Afterschool and Chinatown Big Sibling, to offer youth continuous academic, social, and personal support throughout the school year. CHAD operates in the Chinese Consolidated Benevolent Association in Boston's Chinatown. The program is open to young people living in Chinatown, particularly in the Mass Pike Towers, Castle Square, Oak Terrace, Metropolitan, and Tai Tung Village housing developments.","joiningBasis":{},"aliases":[],"links":[{"kind":"harvard_directory","url":"https://pbha.org/programs/chinatown-adventure","handle":null,"label":"PBHA program page","status":"verified","confidence":0,"signals":["listed by an official Harvard source"],"discoveredVia":["harvard_official"],"lastObservedAt":"2026-09-30T08:45:28.288Z"},{"kind":"x","url":"https://x.com/chadsup","handle":"chadsup","label":null,"status":"unverified","confidence":0,"signals":["only seen on lower-trust sources (best tier 8)"],"discoveredVia":["public_web"],"lastObservedAt":"2026-09-30T12:03:33.772Z"}],"cycles":[],"membership":[],"selectivity":null,"sources":[{"id":"01a0f490-0061-7f57-b69f-0f5525065410","url":"https://soco.college.harvard.edu/club_signup","title":"Student organization directory","sourceType":"harvard_official","trustTier":1,"publisher":"Harvard College Student Organization Center (SOCO)","isFixture":false,"claimCount":5,"lastObservedAt":"2026-09-30T23:04:40.834Z"},{"id":"01a0f17e-f6aa-7485-b0ea-0eece5cfab4d","url":"https://pbha.org/programs/chinatown-adventure","title":"Chinatown Adventure — PBHA","sourceType":"harvard_official","trustTier":1,"publisher":null,"isFixture":false,"claimCount":17,"lastObservedAt":"2026-09-30T10:25:07.804Z"},{"id":"01a0f17d-756a-7702-8a1e-77d393e8b74c","url":"https://www.pbha.org/programs","title":"PBHA Programs","sourceType":"harvard_official","trustTier":1,"publisher":"Phillips Brooks House Association","isFixture":false,"claimCount":5,"lastObser