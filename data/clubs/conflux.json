{"id":"01a0f17d-5d62-71e4-891b-9e1f51d394fd","slug":"conflux","name":"Conflux","acronym":null,"shortDescription":"Student collective exploring the intersection of new media, experimental arts, and creative technology through projects, happenings, and a residency program.","orgType":null,"recognitionStatus":"recognized","activityStatus":"active","joinModes":[],"freshmenEligible":true,"joining":{"comp":false,"dues":false,"roles":[],"access":null,"noCuts":false,"general":[],"conflicts":[],"firstYears":true,"noExperience":true},"categories":[{"slug":"academic-stem","name":"Academic & Research"},{"slug":"technology","name":"Technology & Engineering"},{"slug":"performing-arts","name":"Arts & Performance"}],"memberCount":null,"instagramFollowers":875,"hoursPerWeek":null,"currentCycle":null,"isFixture":false,"completeness":0.5,"sourceCount":12,"lastObservedAt":"2026-10-03T13:25:22.000Z","lastVerifiedAt":"2026-10-01T02:43:29.274Z","eligibleClasses":["first_year","sophomore","junior","senior"],"affiliationScope":"harvard_college","activityConfidence":0.8,"activityReasons":["listed on a current official directory","own website mentions 2025"],"quickLinks":{"website":"https://confluxcollective.org","instagram":"https://www.instagram.com/confluxcollective"},"logo":null,"pressCount":0,"longDescription":"CONFLUXthe process of merging; con- ‘together’ + fluxus Who are we? Conflux is a student organization at Harvard dedicated to exploring and expanding the intersection between new media, experimental arts, and creative technology. Founded on the belief that groundbreaking ways of making, knowing, and being will bloom from cultivating greater interaction between the arts & engineering sciences, our collective merges artistic philosophies with cutting-edge technical development for symbiotic advancement of theory & practice across, between, and within different disciplines.Our institutional support spans Office for the Arts, SEAS Active Learning Labs, Cabot Science Library, metaLAB, and the Visualization Laboratory. We are advised by Prof. Martin Wattenberg, Prof. Fernanda Viégas, and Prof. Katarina Burin. Interested in Conflux? Join our mailing list—we welcome all students, no experience necessary. What do we do? We strive to build an interdisciplinary collective of artists and technologists who will expand the future of art tech at Harvard and beyond. Through projects, happenings, and our residency program, we bridge theory and practice in building what it means for humans and technology to create together. Read about us in The Crimson.","joiningBasis":{"comp":{"rule":"college_directory_no_comp","claimIds":["01a0f490-1ff6-747c-93a4-1ced0397e652"],"sources":[{"url":"https://soco.college.harvard.edu/club_signup","title":"Student organization directory","sourceType":"harvard_official","observedAt":"2026-09-30T23:04:40.834Z","isFixture":false}]},"dues":{"rule":"stated_dues","claimIds":["01a0f490-1ff9-7251-bacd-d2e44c515328"],"sources":[{"url":"https://soco.college.harvard.edu/club_signup","title":"Student organization directory","sourceType":"harvard_official","observedAt":"2026-09-30T23:04:40.834Z","isFixture":false}]},"firstYears":{"rule":"open_population","claimIds":["01a0fb48-87f2-72b7-9035-ca8ec24aff1f"],"sources":[{"url":"https://confluxcollective.org/About","title":"Conflux (Art Tech)","sourceType":"club_website","observedAt":"2026-09-30T08:47:24.173Z","isFixture":false},{"url":"https://confluxcollective.org","title":"Conflux (Art Tech)","sourceType":"club_website","observedAt":"2026-09-30T08:47:21.753Z","isFixture":false}]},"noExperience":{"rule":"stated_no_experience","claimIds":["01a0f201-60b8-743d-9de6-21e0a98458a1"],"sources":[{"url":"https://confluxcollective.org/About","title":"Conflux (Art Tech)","sourceType":"club_website","observedAt":"2026-09-30T08:47:24.173Z","isFixture":false},{"url":"https://confluxcollective.org","title":"Conflux (Art Tech)","sourceType":"club_website","observedAt":"2026-09-30T08:47:21.753Z","isFixture":fals