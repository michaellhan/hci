tudent Organizations","observedAt":"2026-09-30T08:45:20.020Z","isFixture":false,"quote":null},{"sourceId":"","sourceType":"club_website","url":"https://confluxcollective.org/About","title":"Conflux (Art Tech)","observedAt":"2026-09-30T08:47:24.173Z","isFixture":false,"quote":null}]},{"value":"technology","claimId":"01a0f4a4-582c-7cfc-a28e-12ff4e119c1c","badge":"estimate","confidence":0,"assertionKind":"inferred","bestTier":0,"observedAt":"2026-09-30T08:47:24.173Z","asOf":null,"stale":false,"sources":[{"sourceId":"","sourceType":"club_website","url":"https://confluxcollective.org/About","title":"Conflux (Art Tech)","observedAt":"2026-09-30T08:47:24.173Z","isFixture":false,"quote":null}]}]},"club.eligible_classes":{"kind":"single","current":{"value":["first_year","sophomore","junior","senior"],"claimId":"01a0fb48-87f2-72b7-9035-ca8ec24aff1f","badge":"verified","confidence":0,"assertionKind":"stated","bestTier":0,"observedAt":"2026-09-30T08:47:24.173Z","asOf":null,"stale":false,"sources":[{"sourceId":"","sourceType":"club_website","url":"https://confluxcollective.org/About","title":"Conflux (Art Tech)","observedAt":"2026-09-30T08:47:24.173Z","isFixture":false,"quote":null},{"sourceId":"","sourceType":"club_website","url":"https://confluxcollective.org","title":"Conflux (Art Tech)","observedAt":"2026-09-30T08:47:21.753Z","isFixture":false,"quote":null}]},"alternatives":[],"conflict":false},"club.long_description":{"kind":"single","current":{"value":"CONFLUXthe process of merging; con- ‘together’ + fluxus Who are we? Conflux is a student organization at Harvard dedicated to exploring and expanding the intersection between new media, experimental arts, and creative technology. Founded on the belief that groundbreaking ways of making, knowing, and being will bloom from cultivating greater interaction between the arts & engineering sciences, our collective merges artistic philosophies with cutting-edge technical development for symbiotic advancement of theory & practice across, between, and within different disciplines.Our institutional support spans Office for the Arts, SEAS Active Learning Labs, Cabot Science Library, metaLAB, and the Visualization Laboratory. We are advised by Prof. Martin Wattenberg, Prof. Fernanda Viégas, and Prof. Katarina Burin. Interested in Conflux? Join our mailing list—we welcome all students, no experience necessary. What do we do? We strive to build an interdisciplinary collective of artists and technologists who will expand the future of art tech at Harvard and beyond. Through projects, happenings, and our residency program, we bridge theory and practice in building what it means for humans and technology to create together. Read about us in The Crimson.","claimId":"01a0f17f-6528-7022-84e7-c6501680b3ec","badge":"verified","confidence":0,"assertionKind":"stated","bestTier":0,"observedAt":"2026-09-30T10:25:19.543Z","asOf":null,"stale":false,"sources":[{"sourceId":"","sourceType":"club_website","url":"https://confluxcollective.org/About","title":"Conflux (Art Tech)","observedAt":"2026-09-30T10:25:19.543Z","isFixture":false,"quote":null},{"sourceId":"","sourceType":"club_website","url":"https://confluxcollective.org","title":"Conflux (Art Tech)","observedAt":"2026-09-30T10:25:17.058Z","isFixture":false,"quote":null}]},"alternatives":[],"conflict":false},"club.affiliation_scope":{"kind":"single","current":{"value":"harvard_college","claimId":"01a0f490-1ff8-723f-a861-26c91c68341f","badge":"verified","confidence":0,"assertionKind":"stated","bestTier":0,"observedAt":"2026-09-30T23:04:40.834Z","asOf":null,"stale":false,"sources":[{"sourceId":"","sourceType":"harvard_official","url":"https://soco.college.harvard.edu/club_signup","title":"Student organization directory","observedAt":"2026-09-30T23:04:40.834Z","isFixture":false,"quote":null}]},"alternatives":[],"conflict":false},"club.short_description":{"kind":"single","current":{"value":"A student organization at Harvard dedicated to exploring and expanding the in