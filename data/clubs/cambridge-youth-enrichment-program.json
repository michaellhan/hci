{"id":"01a0f17d-7e14-718e-b85a-c61c4fe35241","slug":"cambridge-youth-enrichment-program","name":"PBHA's Cambridge Youth Enrichment Program","acronym":null,"shortDescription":"Summer camp run by college students offering academic enrichment, field trips, and workshops for low-income children at three Cambridge sites.","orgType":"public_service_program","recognitionStatus":"unknown","activityStatus":"likely_active","joinModes":[],"freshmenEligible":null,"joining":{"comp":null,"dues":null,"roles":[],"access":null,"noCuts":false,"general":[],"conflicts":[],"firstYears":null,"noExperience":null},"categories":[{"slug":"public-service","name":"Public Service"},{"slug":"mentoring-education","name":"Mentoring & Education"}],"memberCount":null,"instagramFollowers":null,"hoursPerWeek":null,"currentCycle":null,"isFixture":false,"completeness":0.5,"sourceCount":3,"lastObservedAt":"2026-09-30T23:04:40.834Z","lastVerifiedAt":"2026-09-30T23:04:40.834Z","eligibleClasses":null,"affiliationScope":"harvard_college","activityConfidence":0.55,"activityReasons":["listed on a current official directory"],"quickLinks":{"website":null,"instagram":null},"logo":null,"pressCount":0,"longDescription":"PBHA's Cambridge Youth Enrichment Program, or CYEP, began in 1982 through the joint efforts of Harvard students and parents from Roosevelt Towers, a public housing development in East Cambridge. The program was an expansion of a student-run summer program that had operated out of Roosevelt Towers since 1964. CYEP quickly grew to include children from the nearby Washington Elms and Newtowne Court housing developments. Later, a site at Jefferson Park in North Cambridge was added to meet growing demand. Today, CYEP serves 160 low-income children at three sites across Cambridge for seven weeks each summer. Like all of our Summer Urban Program camps, CYEP engages campers in mornings of academic enrichment, afternoons of educational field trips, and artistic, cultural, and service-learning workshops throughout the week, along with two overnight camping trips and a day-long final trip. CYEP works to prevent summer learning loss, providing an academic foundation from which students may actively and enthusiastically follow their own curiosity. CYEP hopes to inspire creativity and ambition within each and every camper; foster cooperation between campers, staff, and the community; and forge strong ties between youth, parents, and community members.","joiningBasis":{},"aliases":[],"links":[{"kind":"harvard_directory","url":"https://pbha.org/programs/cambridge-youth-enrichment-program","handle":null,"label":"PBHA program page","status":"verified","confidence":0,"signals":["listed by an official Harvard source"],"discoveredVia":["harvard_official"],"lastObservedAt":"2026-09-30T08:45:28.288Z"}],"cycles":[],"membership":[],"selectivity":null,"sources":[{"id":"01a0f490-0061-7f57-b69f-0f5525065410","url":"https://soco.college.harvard.edu/club_signup","title":"Student organization directory","sourceType":"harvard_official","trustTier":1,"publisher":"Harvard College Student Organization Center (SOCO)","isFixture":false,"claimCount":5,"lastObservedAt":"2026-09-30T23:04:40.834Z"},{"id":"01a0f17e-eeef-7075-859e-8a8237edb91f","url":"https://pbha.org/programs/cambridge-youth-enrichment-program","title":"Cambridge Youth Enrichment Program — PBHA","sourceType":"harvard_official","trustTier":1,"publisher":null,"isFixture":false,"claimCount":27,"lastObservedAt":"2026-09-30T10:25:05.527Z"},{"id":"01a0f17d-756a-7702-8a1e-77d393e8b74c","url":"https://www.pbha.org/programs","title":"PBHA Programs","sourceType":"harvard_official","trustTier":1,"publisher":"Phillips Brooks House Association","isFixture":false,"claimCount":4,"lastObservedAt":"2026-09-30T08:45:28.288Z"}],"fields":{"club.tag":{"kind":"multi","values":[{"value":"pbha","claimId":"01a0f490-3734-7aaa-aeec-119e0fb21480","badge":"verified","confidence":0,"assertionKind":"stated","bestTier":0,"observedAt":"2026-09-30T23:04:40.834Z","asO