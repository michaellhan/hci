{"id":"01a0f490-3bf5-7c7f-805b-f1a6f126490e","slug":"harvard-undergraduate-drummers","name":"The Harvard Undergraduate Drummers","acronym":"THUD","shortDescription":"Student percussion group that stages themed shows played on buckets, cups, and boomwhackers for campus audiences.","orgType":null,"recognitionStatus":"recognized","activityStatus":"likely_active","joinModes":["audition"],"freshmenEligible":true,"joining":{"comp":null,"dues":false,"roles":[],"access":"process","noCuts":false,"general":["audition"],"conflicts":[],"firstYears":true,"noExperience":null},"categories":[{"slug":"performing-arts","name":"Arts & Performance"},{"slug":"music","name":"Music"}],"memberCount":null,"instagramFollowers":6063,"hoursPerWeek":null,"currentCycle":null,"isFixture":false,"completeness":0.6,"sourceCount":12,"lastObservedAt":"2026-10-03T13:56:02.000Z","lastVerifiedAt":"2026-09-30T23:04:40.834Z","eligibleClasses":["first_year","sophomore","junior","senior"],"affiliationScope":"harvard_college","activityConfidence":0.55,"activityReasons":["listed on a current official directory"],"quickLinks":{"website":"https://www.harvardundergraddrummers.com/","instagram":"https://www.instagram.com/harvardundergraddrummers"},"logo":null,"pressCount":1,"longDescription":"We're THUD (The Harvard Undergraduate Drummers), a student-run organization at Harvard College that likes to get together on Monday evenings and hit things. We play everything with percussive potential: drum set battles, arrangements of pop and classical music, original pieces on found instruments like plastic cups and chalkboards, drumming on buckets, and more. Inspirations include STOMP and the Blue Man Group. We perform around Harvard Square when it's nice out and are available for gigs in the Cambridge and Boston area, but our work culminates at the end of each semester with our shows. It's honestly hard to convey exactly what we do in just words, so if you want to learn more, check out the video below!","joiningBasis":{"