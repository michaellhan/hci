01"},"claimId":"01a0f2aa-eb95-7423-812d-132e5949659b","badge":"reported","confidence":0,"assertionKind":"stated","bestTier":0,"observedAt":"2026-09-30T14:09:12.813Z","asOf":null,"stale":false,"sources":[{"sourceId":"","sourceType":"harvard_related_other","url":"https://harvardindependent.com/beyond-the-resume","title":"Beyond the Résumé | Harvard Independent","observedAt":"2026-09-30T14:09:12.813Z","isFixture":false,"quote":null}]},{"value":{"url":"https://harvardindependent.com/are-you-competent/","title":"Are You Competent?","publisher":"The Harvard Independent","publishedOn":"2021-09-26"},"claimId":"01a0f2aa-eba4-7455-866d-f01b1b0e9984","badge":"reported","confidence":0,"assertionKind":"stated","bestTier":0,"observedAt":"2026-09-30T14:01:19.636Z","asOf":null,"stale":false,"sources":[{"sourceId":"","sourceType":"harvard_related_other","url":"https://harvardindependent.com/are-you-competent","title":"Are You Competent? | Harvard Independent","observedAt":"2026-09-30T14:01:19.636Z","isFixture":false,"quote":null}]}]},"club.eligible_classes":{"kind":"single","current":{"value":["first_year","sophomore","junior","senior"],"claimId":"01a0fb48-b50f-7d79-b0be-4150645b1b61","badge":"reported","confidence":0,"assertionKind":"stated","bestTier":0,"observedAt":"2026-10-02T20:49:02.097Z","asOf":null,"stale":false,"sources":[{"sourceId":"","sourceType":"public_web","url":"https://hulr.org/join","title":"Join – Harvard Undergraduate Law Review","observedAt":"2026-10-02T20:49:02.097Z","isFixture":false,"quote":null},{"sourceId":"","sourceType":"public_web","url":"https://hulr.org/get-involved","title":"Join – Harvard Undergraduate Law Review","observedAt":"2026-10-02T20:48:59.903Z","isFixture":false,"quote":null}]},"alternatives":[],"conflict":false},"club.long_description":{"kind":"single","current":{"value":"Such “surrendering” of sovereignty was rooted in the concepts of preemption that long preceded the Cherokee vs Georgia and Worcester vs Georgia cases. “Preemption gave the ‘discovering’ (or, in the US case, its successors) power a monopoly over land transactions with the natives, who were prevented from disposing of their land to any other European power” (p. 391). [24] However, as Wolfe adds, “This semblance of native voluntarism has provided scope for some limited judicial magnanimity in regard to Indian sovereignty. In practice, however, the corollary did not apply. Preemption sanctioned European priority but not Indigenous freedom of choice…The American right to buy always superseded the Indian right not to sell.” [25] Essentially, a power imbalance was conceived and later judicially upheld.","claimId":"01a0f8da-6ab8-7664-aa64-9eed6d7408f3","badge":"reported","confidence":0,"assertionKind":"stated","bestTier":0,"observedAt":"2026-10-01T19:04:18.756Z","asOf":null,"stale":false,"sources":[{"sourceId":"","sourceType":"public_web","url":"https://hulr.org/spring-2021/the-legal-history-of-the-united-states-and-its-attack-against-native-americans","title":"The Legal History of the United States and Its Attack Against Native Americans – Harvard Undergraduate Law Review","observedAt":"2026-10-01T19:04:18.756Z","isFixture":false,"quote":null}]},"alternatives":[],"conflict":false},"club.affiliation_scope":{"kind":"single","current":{"value":"harvard_college","claimId":"01a0f490-2d91-7313-a002-9262750f095a","badge":"verified","confidence":0,"assertionKind":"stated","bestTier":0,"observedAt":"2026-10-02T20:49:02.097Z","asOf":null,"stale":false,"sources":[{"sourceId":"","sourceType":"harvard_official","url":"https://soco.college.harvard.edu/club_signup","title":"Student organization directory","observedAt":"2026-09-30T23:04:40.834Z","isFixture":false,"quote":null},{"sourceId":"","sourceType":"public_web","url":"https://hulr.org/join","title":"Join – Harvard Undergraduate Law Review","observedAt":"2026-10-02T20:49:02.097Z","isFixture":false,"quote":null},{"sourceId":"","sourceType":"public_web","url":"https://hulr.org/get-involved","title":"Joi