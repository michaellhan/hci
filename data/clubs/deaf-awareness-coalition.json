{"id":"01a0f17d-8704-79b6-9d83-e6764e96f50e","slug":"deaf-awareness-coalition","name":"PBHA's Deaf Awareness Club","acronym":null,"shortDescription":"Student-run group of Harvard students, faculty, researchers and local residents raising awareness of Deaf culture and accessibility through ASL tables and events.","orgType":"public_service_program","recognitionStatus":"unknown","activityStatus":"likely_active","joinModes":[],"freshmenEligible":null,"joining":{"comp":null,"dues":null,"roles":[],"access":null,"noCuts":false,"general":[],"conflicts":[],"firstYears":null,"noExperience":null},"categories":[{"slug":"public-service","name":"Public Service"},{"slug":"cultural-identity","name":"Cultural & Identity"},{"slug":"advocacy-justice","name":"Advocacy & Justice"}],"memberCount":null,"instagramFollowers":null,"hoursPerWeek":null,"currentCycle":null,"isFixture":false,"completeness":0.5,"sourceCount":4,"lastObservedAt":"2026-09-30T23:13:24.869Z","lastVerifiedAt":"2026-09-30T23:04:40.834Z","eligibleClasses":null,"affiliationScope":"harvard_college","activityConfidence":0.55,"activityReasons":["listed on a current official directory"],"quickLinks":{"website":null,"instagram":null},"logo":null,"pressCount":0,"longDescription":"The Deaf Awareness Coalition (DAC) is a student-run organization, composed of community members from Cambridge and the greater Boston area, along with Harvard University students, faculty, and researchers, all dedicated to raising awareness about Deaf culture and accessibility. DAC is committed to increasing awareness and improving accessibility on campus through social and educational events, volunteer opportunities, university initiatives, and fundraising. In Fall 2021, DAC rebranded as 'Deaf Awareness Coalition' to better represent our mission and our different members and stakeholders. We host regular American Sign Language (ASL) Tables as well as fun “Snack N’ Sign” events where we cultivate an inclusive, accessible, and safe environment for all people who use ASL. DAC encourages native signers as well as those who are new to signing to be a part of something greater than themselves, while always striving to make it clear that the coalition is to never act or speak on behalf of the Deaf community. We emphasize that DAC is foremost a group of people from all backgrounds that share a passion for learning about Deaf culture, American Sign Language, and a commitment to creating a more accessible and anti-audist Harvard community.","joiningBasis":{},"aliases":[],"links":[{"kind":"harvard_directory","url":"https://pbha.org/programs/dac","handle":null,"label":"PBHA program page","status":"verified","confidence":0,"signals":["listed by an official Harvard source"],"discoveredVia":["harvard_official"],"lastObservedAt":"2026-09-30T08:45:30.691Z"},{"kind":"harvard_directory","url":"https://asl.hsites.harvard.edu/deaf-awareness-club","handle":null,"label":"Deaf Awareness Club | American Sign Language at Harvard","status":"unverified","confidence":0,"signals":["only seen on lower-trust sources (best tier 8)"],"discoveredVia":["public_web"],"lastObservedAt":"2026-09-30T23:13:24.869Z"}],"cycles":[],"membership":[],"selectivity":null,"sources":[{"id":"01a0f490-0061-7f57-b69f-0f5525065410","url":"https://soco.college.harvard.edu/club_signup","title":"Student organization directory","sourceType":"harvard_official","trustTier":1,"publisher":"Harvard College Student Organization Center (SOCO)","isFixture":false,"claimCount":5,"lastObservedAt":"2026-09-30T23:04:40.834Z"},{"id":"01a0f17f-3d21-704f-814e-aff4ceb8d454","url":"https://pbha.org/programs/dac","title":"Deaf Awareness Coalition — PBHA","sourceType":"harvard_official","trustTier":1,"publisher":null,"isFixture":false,"claimCount":20,"lastObservedAt":"2026-09-30T10:25:28.356Z"},{"id":"01a0f17d-7e4f-7cb3-8ce8-5c97827faa31","url":"https://www.pbha.org/programs?offset=1734301560265","title":"PBHA Programs (page)","sourceType":"harvard_official","trustTier":1,"publisher":"Phill