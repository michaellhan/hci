{"id":"01a0f17d-8713-7721-8748-24b851e53ad8","slug":"environmental-action-committee-eac","name":"PBHA's Environmental Action Committee","acronym":null,"shortDescription":"Student volunteer program promoting sustainability through an environmental justice lens in Greater Boston via arts, education, gardening, and conference committees.","orgType":"public_service_program","recognitionStatus":"unknown","activityStatus":"likely_active","joinModes":["open"],"freshmenEligible":true,"joining":{"comp":false,"dues":null,"roles":[],"access":"open","noCuts":false,"general":["open"],"conflicts":[],"firstYears":true,"noExperience":null},"categories":[{"slug":"public-service","name":"Public Service"},{"slug":"mentoring-education","name":"Mentoring & Education"},{"slug":"adult-services","name":"Adult Services"},{"slug":"advocacy-justice","name":"Advocacy & Justice"}],"memberCount":null,"instagramFollowers":null,"hoursPerWeek":null,"currentCycle":null,"isFixture":false,"completeness":0.6,"sourceCount":4,"lastObservedAt":"2026-09-30T23:04:40.834Z","lastVerifiedAt":"2026-09-30T23:04:40.834Z","eligibleClasses":null,"affiliationScope":"harvard_college","activityConfidence":0.55,"activityReasons":["listed on a current official directory"],"quickLinks":{"website":null,"instagram":null},"logo":null,"pressCount":0,"longDescription":"The Environmental Action Committee (EAC) works to promote individual, community, and institutional sustainability through the lens of environmental justice in the Greater Boston and Global Community. The EAC runs four committees: the arts, education, gardening, and conferences committees. Arts: explore visual and literary art as an avenue to increase awareness about the climate crisis and its effects. As a volunteer with the arts committee, you will help to run our semester journal called the Canopy and the exhibition of the journal’s entries. Education: engage students and community members in an environmental curriculum to increase climate knowledge. As a volunteer with the education committee, you will first undergo training to be able to work with young adults and children. Volunteers interested in being further involved can help with developing the curriculum team.Gardening: perform direct environmental service in the Boston area, which will include trash clean up, tree planting, clothing swaps, etc. Volunteers will have the opportunity to help lead and plan these events in addition to attending them. Conferences: create a platform through which youth across the nation can discuss some of the most pressing sustainability concerns of our time. Volunteers will have the opportunity to offer said youth the opportunity to enact legislative change through sponsoring, organizing, and/or attending climate gatherings.","joiningBasis":{"comp":{"rule":"open_membership","claimIds":["01a0f224-a232-7ca8-91da-1bf7c56c6a19"],"sources":[{"url":"https://pbha.org/programs/eac","title":"Environmental Action Committee (EAC) — PBHA","sourceType":"harvard_official","observedAt":"2026-09-30T08:47:36.545Z","isFixture":false}]},"access":{"rule":"stated_open","claimIds":["01a0f224-a232-7ca8-91da-1bf7c56c6a19"],"sources":[{"url":"https://pbha.org/programs/eac","title":"Environmental Action Committee (EAC) — PBHA","sourceType":"harvard_official","observedAt":"2026-09-30T08:47:36.545Z","isFixture":false}]},"firstYears":{"rule":"open_population","claimIds":["01a0f224-a232-7ca8-91da-1bf7c56c6a19"],"sources":[{"url":"https://pbha.org/programs/eac","title":"Environmental Action Committee (EAC) — PBHA","sourceType":"harvard_official","observedAt":"2026-09-30T08:47:36.545Z","isFixture":false}]}},"aliases":[],"links":[{"kind":"harvard_directory","url":"https://pbha.org/programs/eac","handle":null,"label":"PBHA program page","status":"verified","confidence":0,"signals":["listed by an official Harvard source"],"discoveredVia":["harvard_official"],"lastObservedAt":"2026-09-30T08:45:30.691Z"},{"kind":"facebook","url":"https://www.facebook.com/harvardeac","h