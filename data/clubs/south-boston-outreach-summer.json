{"id":"01a0f17d-90c9-7dd6-a796-bcce78db3668","slug":"south-boston-outreach-summer","name":"PBHA's South Boston Outreach Summer","acronym":null,"shortDescription":"Seven-week academic summer day camp for South Boston children ages 6–13, run by college student directors and counselors.","orgType":"public_service_program","recognitionStatus":"unknown","activityStatus":"likely_active","joinModes":[],"freshmenEligible":null,"joining":{"comp":null,"dues":null,"roles":[],"access":null,"noCuts":false,"general":[],"conflicts":[],"firstYears":null,"noExperience":null},"categories":[{"slug":"public-service","name":"Public Service"},{"slug":"mentoring-education","name":"Mentoring & Education"}],"memberCount":null,"instagramFollowers":null,"hoursPerWeek":null,"currentCycle":null,"isFixture":false,"completeness":0.5,"sourceCount":3,"lastObservedAt":"2026-09-30T23:04:40.834Z","lastVerifiedAt":"2026-09-30T23:04:40.834Z","eligibleClasses":null,"affiliationScope":"harvard_college","activityConfidence":0.55,"activityReasons":["listed on a current official directory"],"quickLinks":{"website":null,"instagram":null},"logo":null,"pressCount":0,"longDescription":"PBHA’s South Boston Outreach Summer, or SBOS, offers an academic summer day camp for young people ages 6–13 from South Boston for seven weeks each summer. Like all of our Summer Urban Program camps, SOBS engages campers in mornings of academic enrichment, afternoons of educational field trips, and artistic, cultural, and service-learning workshops throughout the week, along with two overnight camping trips and a day-long final trip. SBOS strives to empower youth through hands-on enrichment activities that emphasize academic confidence, conflict resolution, interdependence, prevention of risk-taking behaviors, and respect for diversity. The program places a significant focus on curricula that utilize substance abuse prevention and service learning to support the academic achievement and positive youth development of our campers and combat historically widespread issues endured by the South Boston community. SBOS began in 1989 when Theresa Finn, a Harvard student who had grown up in South Boston, founded an adult tutoring program for mothers. She had volunteered at Julie’s Family Learning Program, a neighborhood-based family support and education program, when she realized that more programming was needed, particularly during the summer. She turned to Suzanne Panico, another Harvard student from South Boston, to create a summer program that would allow the women being tutored to attend full-time programming by alleviating the need for day care during summer vacation. Since its founding, SBOS has provided a continuum of service to the residents in and around South Boston’s three public housing developments: Mary Ellen McCormack, Old Colony, and West Broadway.","joiningBasis":{},"aliases":[],"links":[{"kind":"harvard_directory","url":"https://pbha.org/programs/south-boston-outreach-summer","handle":null,"label":"PBHA program page","status":"verified","confidence":0,"signals":["listed by an official Harvard source"],"discoveredVia":["harvard_official"],"lastObservedAt":"2026-09-30T08:45:33.103Z"}],"cycles":[],"membership":[],"selectivity":null,"sources":[{"id":"01a0f490-0061-7f57-b69f-0f5525065410","url":"https://soco.college.harvard.edu/club_signup","title":"Student organization directory","sourceType":"harvard_official","trustTier":1,"publisher":"Harvard College Student Organization Center (SOCO)","isFixture":false,"claimCount":5,"lastObservedAt":"2026-09-30T23:04:40.834Z"},{"id":"01a0f1dc-5071-74d5-92cc-1bc2e83cfc54","url":"https://pbha.org/programs/south-boston-outreach-summer","title":"South Boston Outreach Summer — PBHA","sourceType":"harvard_official","trustTier":1,"publisher":null,"isFixture":false,"claimCount":18,"lastObservedAt":"2026-09-30T10:29:04.940Z"},{"id":"01a0f17d-8791-7bd8-ba91-7759512e0d1e","url":"https://www.pbha.org/programs?offset=1705368180217","title":"PBHA Programs (page