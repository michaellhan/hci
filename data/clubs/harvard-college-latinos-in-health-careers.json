{"id":"01a0f17d-cec2-7c49-a1a1-94a30ce0daa5","slug":"harvard-college-latinos-in-health-careers","name":"Harvard Undergraduate Latines in Health Careers","acronym":null,"shortDescription":"Harvard Latinos in Health Careers (LiHC) is a pre-professional organization whose objective is to provide undergraduate students with the resources to pursue their interest in a health profession.","orgType":null,"recognitionStatus":"recognized","activityStatus":"likely_active","joinModes":[],"freshmenEligible":null,"joining":{"comp":false,"dues":false,"roles":[],"access":null,"noCuts":false,"general":[],"conflicts":[],"firstYears":null,"noExperience":null},"categories":[{"slug":"cultural-identity","name":"Cultural & Identity"},{"slug":"medicine-health","name":"Health & Medicine"}],"memberCount":null,"instagramFollowers":null,"hoursPerWeek":null,"currentCycle":null,"isFixture":false,"completeness":0.4,"sourceCount":2,"lastObservedAt":"2026-10-01T05:23:03.706Z","lastVerifiedAt":"2026-10-01T05:23:03.706Z","eligibleClasses":null,"affiliationScope":"harvard_college","activityConfidence":0.55,"activityReasons":["listed on a current official directory"],"quickLinks":{"website":null,"instagram":null},"logo":null,"pressCount":0,"longDescription":"Harvard Latinos in Health Careers (LiHC) is a pre-professional organization whose objective is to provide undergraduate students with the resources to pursue their interest in a health profession. LiHC seeks to empower undergraduate pre-health students with academic, professional, social, cultural, and community resources. The group seeks to promote greater awareness and understanding of cultural and social issues that impact the health of our communities both within Harvard and around the world by appropriate means such as publications, meetings, seminars, and other educational activities. All undergraduate students are welcome, especially those interested in medicine and the health sciences. While Latin-American health care issues will be emphas