bestTier":0,"observedAt":"2026-09-30T08:47:57.646Z","asOf":null,"stale":false,"sources":[{"sourceId":"","sourceType":"club_website","url":"https://harmonymentoring.org/board-applications","title":"Board Applications | HARMONY Mentoring","observedAt":"2026-09-30T08:47:57.646Z","isFixture":false,"quote":null}]},"alternatives":[],"conflict":false},"club.long_description":{"kind":"single","current":{"value":"PBHA's HARMONY Mentoring (HARMONY) serves the Cambridge community by enlisting college students to provide free music lessons to low-income K-12 mentees. Since the early 1990s, student volunteers have been providing free one-on-one music lessons to under-resourced children in local public schools who cannot afford and/or access traditional private music instruction. We welcome instrumentalists and vocalists from all backgrounds to join our community.HARMONY volunteers dedicate at least one hour each week to providing the highest quality instruction to their mentees. During weekly meetings, volunteers often begin with technique and review, before moving into new material. Mentors and mentees develop a close relationship founded in mutual learning and respect, which can continue over the course of multiple semesters and years.HARMONY’s goal is to bridge the financial divide that keeps musical instruments out of the hands of young musicians. Music education has a boundless impact on the Cambridge community, both now and in the future. Coming out of the chaos of the pandemic, music represents a creative outlet through which youth can express themselves, having major benefits for their mental health. Moreover, as our mentees grow, they will be able to share their gift of music with many others in Cambridge.","claimId":"01a0f17f-b205-7633-979a-e838be164be0","badge":"verified","confidence":0,"assertionKind":"stated","bestTier":0,"observedAt":"2026-09-30T10:25:48.956Z","asOf":null,"stale":false,"sources":[{"sourceId":"","sourceType":"harvard_official","url":"https://pbha.org/programs/harmony-mentoring","title":"HARMONY Mentoring — PBHA","observedAt":"2026-09-30T10:25:48.956Z","isFixture":false,"quote":null}]},"alternatives":[],"conflict":false},"club.affiliation_scope":{"kind":"single","current":{"value":"harvard_college","claimId":"01a0f490-3844-784b-87c1-890a01fb4c6c","badge":"verified","confidence":0,"assertionKind":"stated","bestTier":0,"observedAt":"2026-09-30T23:04:40.834Z","asOf":null,"stale":false,"sources":[{"sourceId":"","sourceType":"harvard_official","url":"https://soco.college.harvard.edu/club_signup","title":"Student organization directory","observedAt":"2026-09-30T23:04:40.834Z","isFixture":false,"quote":null}]},"alternatives":[],"conflict":false},"club.short_description":{"kind":"single","current":{"value":"PBHA's HARMONY Mentoring (HARMONY) serves the Cambridge community by enlisting college students to provide free one-on-one music lessons to low-income K-12 mentees.","claimId":"01a0f17d-875a-7a03-a563-835b5a76468e","badge":"verified","confidence":0,"assertionKind":"stated","bestTier":0,"observedAt":"2026-09-30T10:25:48.956Z","asOf":null,"stale":false,"sources":[{"sourceId":"","sourceType":"harvard_official","url":"https://pbha.org/programs/harmony-mentoring","title":"HARMONY Mentoring — PBHA","observedAt":"2026-09-30T10:25:48.956Z","isFixture":false,"quote":null},{"sourceId":"","sourceType":"harvard_official","url":"https://www.pbha.org/programs?offset=1734301560265","title":"PBHA Programs (page)","observedAt":"2026-09-30T08:45:30.691Z","isFixture":false,"quote":null}]},"alternatives":[],"conflict":false},"club.recruiting_seasons":{"kind":"single","current":{"value":["rolling"],"claimId":"01a0f28d-8e50-72b8-a99d-1f25f614c6fc","badge":"verified","confidence":0,"assertionKind":"stated","bestTier":0,"observedAt":"2026-09-30T08:48:06.621Z","asOf":null,"stale":false,"sources":[{"sourceId":"","sourceType":"harvard_official","url":"https://pbha.org/programs/harmony-mentoring","title":"HARMONY Mentoring — PBHA","observedAt"