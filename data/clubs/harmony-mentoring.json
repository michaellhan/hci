{"id":"01a0f17d-8757-7562-8151-99fd955aaf1c","slug":"harmony-mentoring","name":"PBHA's HARMONY Mentoring","acronym":null,"shortDescription":"Music lessons and enrichment for K–9 students in Cambridge and Greater Boston, run by volunteers through afterschool, school-year, and summer programs.","orgType":"public_service_program","recognitionStatus":"unknown","activityStatus":"active","joinModes":["application"],"freshmenEligible":true,"joining":{"comp":null,"dues":null,"roles":[],"access":"process","noCuts":false,"general":["application"],"conflicts":[],"firstYears":true,"noExperience":null},"categories":[{"slug":"public-service","name":"Public Service"},{"slug":"mentoring-education","name":"Mentoring & Education"}],"memberCount":null,"instagramFollowers":190,"hoursPerWeek":null,"currentCycle":{"id":"01a0f17f-e81b-7ae0-a9e8-76491771c17d","termKey":"2026-fall","track":"main","status":"unknown","statedStatus":null,"opens":null,"deadline":null,"processTypes":[],"applicationUrl":null,"eligibleClasses":null,"lastVerifiedAt":"2026-09-30T10:26:02.170Z","stages":[],"applicants":null,"admits":null,"fields":{}},"isFixture":false,"completeness":0.6,"sourceCount":12,"lastObservedAt":"2026-10-03T13:31:32.000Z","lastVerifiedAt":"2026-10-01T14:46:57.382Z","eligibleClasses":["first_year","sophomore","junior","senior"],"affiliationScope":"harvard_college","activityConfidence":0.8,"activityReasons":["listed on a current official directory","own website mentions 2025"],"quickLinks":{"website":"https://www.harmonymentoring.org/","instagram":"https://www.instagram.com/harvardharmony"},"logo":null,"pressCount":0,"longDescription":"PBHA's HARMONY Mentoring (HARMONY) serves the Cambridge community by enlisting college students to provide free music lessons to low-income K-12 mentees. Since the early 1990s, student volunteers have been providing free one-on-one music lessons to under-resourced children in local public schools who cannot afford and/or access traditional private music instruction. We welcome instrumentalists and vocalists from all backgrounds to join our community.HARMONY volunteers dedicate at least one hour each week to providing the highest quality instruction to their mentees. During weekly meetings, volunteers often begin with technique and review, before moving into new material. Mentors and mentees develop a close relationship founded in mutual learning and respect, which can continue over the course of multiple semesters and years.HARMONY’s goal is to bridge the financial divide that keeps musical instruments out of the hands of young musicians. Music education has a boundless impact on the Cambridge community, both now and in the future. Coming out of the chaos of the pandemic, music represents a creative outlet through which youth can express themselves, having major benefits for their mental health. Moreover, as our mentees grow, they will be able to share their gift of music with many others in Cambridge.","joiningBasis":{"access":{"rule":"stated_process","claimIds":["01a0f224-e320-7845-a0ea-ca393a068709"],"sources":[{"url":"https://harmonymentoring.org/volunteer","title":"Support Harmony Mentoring | HARMONY Mentoring","sourceType":"club_website","observedAt":"2026-09-30T08:48:06.621Z","isFixture":false},{"url":"https://pbha.org/programs/harmony-mentoring","title":"HARMONY Mentoring — PBHA","sourceType":"harvard_official","observedAt":"2026-09-30T08:47:52.794Z","isFixture":false}]},"firstYears":{"rule":"open_population","claimIds":["01a0f201-75f1-7222-9d91-a0cfb4fdf9de"],"sources":[{"url":"https://harmonymentoring.org/board-applications","title":"Board Applications | HARMONY Mentoring","sourceType":"club_website","observedAt":"2026-09-30T08:47:57.646Z","isFixture":false}]}},"aliases":[],"links":[{"kind":"application_page","url":"https://harmonymentoring.org/join","handle":null,"label":"Join","status":"verified","confidence":0,"signals":["linked from the club's official website"],"discoveredVia":["club_website"],"lastObservedAt