stTier":0,"observedAt":"2026-09-30T22:03:58.416Z","asOf":null,"stale":false,"sources":[{"sourceId":"","sourceType":"public_web","url":"https://harvardphilosophyreview.com/comp","title":"Comp | Harvard Review of Philosophy","observedAt":"2026-09-30T22:03:58.416Z","isFixture":false,"quote":null}]}]},"club.eligible_classes":{"kind":"single","current":{"value":["first_year","sophomore","junior","senior"],"claimId":"01a0f23e-a7f3-7807-8ead-f846f0882d8d","badge":"reported","confidence":0,"assertionKind":"stated","bestTier":0,"observedAt":"2026-09-30T12:16:07.153Z","asOf":null,"stale":false,"sources":[{"sourceId":"","sourceType":"public_web","url":"https://harvardphilosophyreview.com/comp","title":"Comp | Harvard Review of Philosophy","observedAt":"2026-09-30T12:16:07.153Z","isFixture":false,"quote":null}]},"alternatives":[],"conflict":false},"club.long_description":{"kind":"single","current":{"value":"The Harvard Review of Philosophy is a journal of professional philosophy published annually since 1991 and edited entirely by Harvard University undergraduates. The Review is one of only two such undergraduate-run journals, and remains the only publication of its kind to be published in print. Presently, the Review is distributed to over a thousand universities and libraries throughout the world. Its pages have included work by and interviews with leading figures in contemporary philosophy, including Derek Parfit, Sir Karl Popper, Martha Nussbaum, W. V. Quine, Cornel West, John Rawls, Noam Chomsky, Peter Singer, Slavoj Žižek, Hilary Putnam, and Bernard Williams. Three books have been published featuring work from the pages of the Review. Since our 25th volume, each issue of the Review has been centered around a philosophical theme and aims to present a range of original research on the chosen theme in a manner accessible to a general audience. In addition to publishing a volume each year, the Review has hosted an annual lecture since 2002 with support from the Harvard University Department of Philosophy.","claimId":"01a0f23e-a7ec-71db-912d-43326e8560f2","badge":"reported","confidence":0,"assertionKind":"stated","bestTier":0,"observedAt":"2026-09-30T12:16:09.474Z","asOf":null,"stale":false,"sources":[{"sourceId":"","sourceType":"public_web","url":"https://harvardphilosophyreview.com/who-we-are-and-masthead","title":"Who We Are & Masthead | Harvard Review of Philosophy","observedAt":"2026-09-30T12:16:09.474Z","isFixture":false,"quote":null}]},"alternatives":[],"conflict":false},"club.affiliation_scope":{"kind":"single","current":{"value":"harvard_college","claimId":"01a0f490-2762-71a4-be1a-254c28a542a5","badge":"verified","confidence":0,"assertionKind":"stated","bestTier":0,"observedAt":"2026-09-30T23:04:40.834Z","asOf":null,"stale":false,"sources":[{"sourceId":"","sourceType":"harvard_official","url":"https://soco.college.harvard.edu/club_signup","title":"Student organization directory","observedAt":"2026-09-30T23:04:40.834Z","isFixture":false,"quote":null},{"sourceId":"","sourceType":"public_web","url":"https://harvardphilosophyreview.com/our-magazine","title":"Our Magazine | Harvard Review of Philosophy","observedAt":"2026-09-30T13:00:09.390Z","isFixture":false,"quote":null},{"sourceId":"","sourceType":"public_web","url":"https://harvardphilosophyreview.com/for-authors","title":"For Authors | Harvard Review of Philosophy","observedAt":"2026-09-30T12:16:16.462Z","isFixture":false,"quote":null}]},"alternatives":[],"conflict":false},"club.short_description":{"kind":"single","current":{"value":"which publishes professional[clarification needed] philosophy","claimId":"01a0f17e-a4c3-75b9-9f63-cdfe7f6144fa","badge":"reported","confidence":0,"assertionKind":"stated","bestTier":0,"observedAt":"2026-10-01T14:44:14.838Z","asOf":null,"stale":false,"sources":[{"sourceId":"","sourceType":"public_web","url":"https://en.wikipedia.org/wiki/List_of_Harvard_College_undergraduate_organizations","title":"Wikipedia: List of Harvard College undergraduate or