{"id":"01a0f17e-a349-7610-bea2-b0a393cf23be","slug":"harvard-fallen-angels","name":"Fallen Angels","acronym":null,"shortDescription":"Upper-voice contemporary a cappella group that arranges its own songs, performs in Sanders Theatre twice a year, and is available for hire in the Boston area.","orgType":null,"recognitionStatus":"recognized","activityStatus":"active","joinModes":["audition"],"freshmenEligible":null,"joining":{"comp":null,"dues":false,"roles":[],"access":"process","noCuts":false,"general":["audition"],"conflicts":[],"firstYears":null,"noExperience":null},"categories":[{"slug":"performing-arts","name":"Arts & Performance"},{"slug":"a-cappella","name":"A cappella"}],"memberCount":null,"instagramFollowers":871,"hoursPerWeek":{"min":6,"max":6},"currentCycle":{"id":"01a0f23d-a6b0-7a56-a42c-cce81f2014f3","termKey":"2026-fall","track":"main","status":"unknown","statedStatus":null,"opens":null,"deadline":null,"processTypes":[],"applicationUrl":null,"eligibleClasses":null,"lastVerifiedAt":"2026-09-30T12:15:11.221Z","stages":[{"ordinal":1,"kind":"audition","label":"pre-lim auditions","startsAt":null,"endsAt":null},{"ordinal":2,"kind":"interview","label":"callbacks","startsAt":null,"endsAt":null},{"ordinal":3,"kind":"final_round","label":"Final Night","startsAt":null,"endsAt":null}],"applicants":null,"admits":null,"fields":{"cycle.stages":{"kind":"single","current":{"value":[{"kind":"audition","label":"pre-lim auditions","order":1},{"kind":"interview","label":"callbacks","order":2},{"kind":"final_round","label":"Final Night","order":3}],"claimId":"01a0f4bd-ecaf-766b-9f03-7d5e8c0264da","badge":"verified","confidence":0,"assertionKind":"stated","bestTier":0,"observedAt":"2026-09-30T12:15:11.221Z","asOf":null,"stale":false,"sources":[{"sourceId":"","sourceType":"club_website","url":"https://fallenangelsacappella.com/auditions.html","title":"Auditions - The Harvard Fallen Angels","observedAt":"2026-09-30T12:15:11.221Z","isFixture":false,"quote":null}]},"alternatives":[],"conflict":false}}},"isFixture":false,"completeness":0.7,"sourceCount":13,"lastObservedAt":"2026-10-04T02:39:12.917Z","lastVerifiedAt":"2026-09-30T23:04:40.834Z","eligibleClasses":null,"affiliationScope":"harvard_college","activityConfidence":0.8,"activityReasons":["listed on a current official directory","own website mentions 2027"],"quickLinks":{"website":"https://www.fallenangelsacappella.com/","instagram":"https://instagram.com/harvardfallenangels"},"logo":null,"pressCount":1,"longDescription":"We are the only a cappella group at Harvard college that guarantees a solo for every member every semester! We are proud of our members' voices and we want to be able to show them off! Everyone always gets a chance to shine.All our members nominate and vote on songs every semester to create our setlist for the following semester. Not only do we have a new setlist every semester, but our members all collectively decide what that set list will be! You'll never get bored of our setlist because it's always adapting to our members and their personal styles.Every senior gets to choose a senior solo. Every spring our graduating seniors get to choose a full song they want to solo on in Sanders Theatre! Not only do they get to choose whatever song they like, but they get to arrange it as well so their final Fallen Angels performance sounds exactly how they want it! Which brings us to...We arrange all of our own music! Every song we perform is arranged by our members, and everyone gets the opportunity to arrange, whether they are a music director or not.We understand that first and foremost, our members are Harvard students. Academics should always, and will always, come first in FA. We don't expect the Fallen Angels to be your only commitment. It's this attitude that allows us to do so many amazing things outside of a cappella!","joiningBasis":{"dues":{"rule":"stated_dues","claimIds":["01a0f490-20b1-7823-919d-a90baafb4f70"],"sources":[{"url":"https://soco.college.harvard.edu/c