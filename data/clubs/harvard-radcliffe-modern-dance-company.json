proach of an hour “too late,” and the night, a performance, must end? At the core of our spring 2024 show, we aim to visualize this movement and struggle against time and limits, something that drives us to chase a goal or brings us to a point of no return. Made possible through a Spring 2024 Student-Led Dance Group Residency through the Office for the Arts (OFA) at Harvard Dance Program and through a COOP grant.In residence at the Harvard Dance Center from April 14 to 20th.​Directed by Sarah Erickson '25 and Karen Song '25.","claimId":"01a101ca-ad55-7a1f-89f0-a91b1276c3ab","badge":"verified","confidence":0,"assertionKind":"stated","bestTier":0,"observedAt":"2026-10-03T12:43:39.720Z","asOf":null,"stale":false,"sources":[{"sourceId":"","sourceType":"club_website","url":"https://hrmdc.org/our-shows.html","title":"Our Shows - HRMDC","observedAt":"2026-10-03T12:43:39.720Z","isFixture":false,"quote":null}]},"alternatives":[],"conflict":false},"club.activity":{"kind":"multi","values":[{"value":"weekly company classes","claimId":"01a101ca-b3e7-748e-af5c-a959b26b3bff","badge":"verified","confidence":0,"assertionKind":"stated","bestTier":0,"observedAt":"2026-10-03T12:40:37.892Z","asOf":null,"stale":false,"sources":[{"sourceId":"","sourceType":"club_website","url":"https://hrmdc.org/about-us.html","title":"About Us - HRMDC","observedAt":"2026-10-03T12:40:37.892Z","isFixture":false,"quote":null}]}]},"club.category":{"kind":"multi","values":[{"value":"performing-arts","claimId":"01a101c9-7241-75f2-9727-ed2ace0d9a38","badge":"verified","confidence":0,"assertionKind":"editorial","bestTier":0,"observedAt":"2026-10-04T02:39:12.995Z","asOf":null,"stale":false,"sources":[{"sourceId":"","sourceType":"editorial","url":"https://hclubs.app/about#editorial","title":"Link supplied by the index editor","observedAt":"2026-10-04T02:39:12.995Z","isFixture":false,"quote":null}]},{"value":"dance","claimId":"01a101c9-7240-7c17-b6a7-a04f2886881e","badge":"verified","confidence":0,"assertionKind":"