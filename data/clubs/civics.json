omote civic engagement and youth advocacy.CIVICS is grounded in a committment to equity in education. The program is dedicated to reaching students from diverse socioeconomic and cultural backgrounds, offering a curriculum that is not only academically rigorous but also culturally relevant and empowering. By addressing the civic education gap, Harvard CIVICS strives to inspire the next generation of informed, active participants in our democracy.","claimId":"01a0f17f-461d-79bc-834f-e1105e9efb16","badge":"verified","confidence":0,"assertionKind":"stated","bestTier":0,"observedAt":"2026-09-30T10:25:21.041Z","asOf":null,"stale":false,"sources":[{"sourceId":"","sourceType":"harvard_official","url":"https://pbha.org/programs/civics","title":"CIVICS — PBHA","observedAt":"2026-09-30T10:25:21.041Z","isFixture":false,"quote":null}]},"alternatives":[],"conflict":false},"club.affiliation_scope":{"kind":"single","current":{"value":"harvard_college","claimId":"01a0f8df-4035-71f7-95e1-0693a8c5724e","badge":"verified","confidence":0,"assertionKind":"stated","bestTier":0,"observedAt":"2026-09-30T23:04:40.834Z","asOf":null,"stale":false,"sources":[{"sourceId":"","sourceType":"harvard_official","url":"https://soco.college.harvard.edu/club_signup","title":"Student organization directory","observedAt":"2026-09-30T23:04:40.834Z","isFixture":false,"quote":null},{"sourceId":"","sourceType":"harvard_official","url":"https://iop.harvard.edu/programs/civics","title":"CIVICS | The Institute of Politics at Harvard University","observedAt":"2026-09-30T08:47:13.930Z","isFixture":false,"quote":null}]},"alternatives":[],"conflict":false},"club.short_description":{"kind":"single","current":{"value":"Harvard CIVICS is a joint initiative between the Phillips Brooks House Association (PBHA) and the Institute of Politics, bringing civic education to over 35 classrooms across the Cambridge and Boston Public School systems.","claimId":"01a0f17d-7e43-7099-afea-76250c5c42a3","badge":"verified","confidence"